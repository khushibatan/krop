# KROP Environment Configuration (Optional)
# Open-Meteo does not require an API key for standard non-commercial use.
# Kaggle API credentials can be placed here if not using ~/.kaggle/kaggle.json
KAGGLE_USERNAME=
KAGGLE_KEY=

# SQLite database location (relative to the project root; defaults to database/krop.db)
DATABASE_PATH=database/krop.db

# App Settings
APP_ENV=development
